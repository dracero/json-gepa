---
import katex from "katex";
import "katex/dist/katex.min.css";

export interface Props {
  item: {
    question: string;
    context: string;
    professor_response: string;
  };
  index: number;
}

const { item, index } = Astro.props;

function renderLatex(text: string): string {
  let result = text.replace(/\$\$([^$]+)\$\$/g, (_, expr) => {
    try {
      return katex.renderToString(expr.trim(), { displayMode: true, throwOnError: false });
    } catch {
      return `$$${expr}$$`;
    }
  });
  result = result.replace(/\$([^$\n]+)\$/g, (_, expr) => {
    try {
      return katex.renderToString(expr.trim(), { displayMode: false, throwOnError: false });
    } catch {
      return `$${expr}$`;
    }
  });
  return result;
}

const renderedQuestion = renderLatex(item.question);
const renderedResponse = renderLatex(item.professor_response);
---

<article class="qa-card" role="article" data-index={index}>
  <div class="qa-card__header">
    <span class="qa-card__number">#{index + 1}</span>
    <span class="qa-card__context">{item.context}</span>
  </div>

  <div class="qa-card__question">
    <h3>Pregunta</h3>
    <div contenteditable="true" class="editable-content" id={`question-text-${index}`} set:html={renderedQuestion} />
  </div>

  <div class="qa-card__response">
    <h3>Respuesta del Profesor</h3>
    <div contenteditable="true" class="editable-content" id={`response-text-${index}`} set:html={renderedResponse} />
  </div>

  <!-- ── AI Analysis Panel ─────────────────────────────────────── -->
  <div class="analysis-panel" id={`analysis-panel-${index}`}>
    <button
      class="analysis-trigger"
      id={`analysis-btn-${index}`}
      data-index={index}
      data-context={item.context}
      aria-expanded="false"
      aria-controls={`analysis-content-${index}`}
    >
      <span class="analysis-trigger__icon">✨</span>
      <span class="analysis-trigger__label">Analizar con IA</span>
      <span class="analysis-trigger__chevron">›</span>
    </button>

    <div class="analysis-content" id={`analysis-content-${index}`} hidden>
      <!-- Loading state -->
      <div class="analysis-loading" id={`analysis-loading-${index}`} hidden>
        <div class="analysis-spinner"></div>
        <span>Analizando con Gemini...</span>
      </div>

      <!-- Error state -->
      <div class="analysis-error" id={`analysis-error-${index}`} hidden></div>

      <!-- Results grid (4 agents) -->
      <div class="analysis-grid" id={`analysis-grid-${index}`} hidden>
        <div class="agent-card agent-card--question">
          <div class="agent-card__badge">
            <span class="agent-card__icon">🔍</span>
            <span>Agente 1 · Pregunta</span>
          </div>
          <div contenteditable="true" class="agent-card__body editable-content" id={`qa-${index}`}></div>
        </div>

        <div class="agent-card agent-card--response">
          <div class="agent-card__badge">
            <span class="agent-card__icon">📝</span>
            <span>Agente 2 · Respuesta</span>
          </div>
          <div contenteditable="true" class="agent-card__body editable-content" id={`ra-${index}`}></div>
        </div>

        <div class="agent-card agent-card--retrieval">
          <div class="agent-card__badge">
            <span class="agent-card__icon">🗄️</span>
            <span>Agente 3 · Qdrant</span>
          </div>
          <div contenteditable="true" class="agent-card__body editable-content" id={`ret-${index}`}></div>
        </div>

        <div class="agent-card agent-card--suggestions">
          <div class="agent-card__badge">
            <span class="agent-card__icon">💡</span>
            <span>Agente 4 · Sugerencias</span>
          </div>
          <div contenteditable="true" class="agent-card__body editable-content" id={`sug-${index}`}></div>
        </div>
      </div>
    </div>
  </div>
</article>

<script>
  const API_URL = (window as any).__API_URL__ ?? "http://localhost:8000";

  function formatText(raw: string): string {
    // Convert Gemini markdown output to safe HTML
    const lines = raw.split("\n");
    const out: string[] = [];
    let inList = false;

    for (const line of lines) {
      const t = line.trim();
      if (!t) {
        if (inList) { out.push("</ul>"); inList = false; }
        continue;
      }

      // ## heading
      if (t.startsWith("## ")) {
        if (inList) { out.push("</ul>"); inList = false; }
        out.push(`<h4>${md(t.slice(3))}</h4>`);
        continue;
      }
      // # heading
      if (t.startsWith("# ")) {
        if (inList) { out.push("</ul>"); inList = false; }
        out.push(`<h4>${md(t.slice(2))}</h4>`);
        continue;
      }

      // Bullet: lines starting with exactly one * (not **), -, or •
      // Must check before bold to avoid matching **bold text** as a bullet.
      const bulletMatch = t.match(/^([\-•]|\*(?!\*))\s+(.+)/);
      if (bulletMatch) {
        if (!inList) { out.push("<ul>"); inList = true; }
        out.push(`<li>${md(bulletMatch[2])}</li>`);
        continue;
      }

      // Numbered list: 1. text
      const numMatch = t.match(/^\d+\.\s+(.+)/);
      if (numMatch) {
        if (!inList) { out.push("<ul>"); inList = true; }
        out.push(`<li>${md(numMatch[1])}</li>`);
        continue;
      }

      if (inList) { out.push("</ul>"); inList = false; }
      out.push(`<p>${md(t)}</p>`);
    }

    if (inList) out.push("</ul>");
    return out.join("");
  }

  // Inline markdown: **bold**, *italic*, `code`
  function md(s: string): string {
    return s
      .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
      .replace(/\*(.+?)\*/g, "<em>$1</em>")
      .replace(/`(.+?)`/g, "<code>$1</code>");
  }

  document.querySelectorAll<HTMLButtonElement>(".analysis-trigger").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const idx = btn.dataset.index!;
      const content = document.getElementById(`analysis-content-${idx}`)!;
      const loading = document.getElementById(`analysis-loading-${idx}`)!;
      const errorEl = document.getElementById(`analysis-error-${idx}`)!;
      const grid = document.getElementById(`analysis-grid-${idx}`)!;

      const isOpen = btn.getAttribute("aria-expanded") === "true";

      // Toggle open/close
      if (isOpen) {
        content.hidden = true;
        btn.setAttribute("aria-expanded", "false");
        btn.querySelector<HTMLElement>(".analysis-trigger__chevron")!.style.transform = "";
        return;
      }

      btn.setAttribute("aria-expanded", "true");
      btn.querySelector<HTMLElement>(".analysis-trigger__chevron")!.style.transform = "rotate(90deg)";
      content.hidden = false;

      // Don't re-fetch if already loaded
      if (!grid.hidden) return;

      loading.hidden = false;
      errorEl.hidden = true;

      try {
        const currentQuestion = document.getElementById(`question-text-${idx}`)?.innerText || "";
        const currentResponse = document.getElementById(`response-text-${idx}`)?.innerText || "";

        const res = await fetch(`${API_URL}/analyze`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            question: currentQuestion,
            agent_response: currentResponse,
            retrieval_context: btn.dataset.context ?? "",
          }),
        });

        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          const errMsg = err?.detail?.error ?? err?.error ?? (typeof err?.detail === 'string' ? err?.detail : null) ?? `HTTP ${res.status}`;
          throw new Error(errMsg);
        }

        const data = await res.json();

        document.getElementById(`qa-${idx}`)!.innerHTML = formatText(data.question_analysis);
        document.getElementById(`ra-${idx}`)!.innerHTML = formatText(data.response_analysis);
        document.getElementById(`ret-${idx}`)!.innerHTML = formatText(data.retrieval_analysis);
        document.getElementById(`sug-${idx}`)!.innerHTML = formatText(data.improvement_suggestions);

        loading.hidden = true;
        grid.hidden = false;
      } catch (err: any) {
        loading.hidden = true;
        errorEl.hidden = false;
        errorEl.textContent = `Error: ${err.message}`;
      }
    });
  });
</script>

<style>
  /* ── Base card ───────────────────────────────────────────────── */
  .qa-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    transition: box-shadow 0.2s ease;
  }
  .qa-card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
  }
  .qa-card__header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .qa-card__number {
    background: #6366f1;
    color: white;
    border-radius: 50%;
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    font-weight: 700;
    flex-shrink: 0;
  }
  .qa-card__context {
    font-size: 0.8rem;
    color: #64748b;
    background: #f1f5f9;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-weight: 500;
  }
  .qa-card__question {
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #f1f5f9;
  }
  .qa-card__question h3,
  .qa-card__response h3 {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #94a3b8;
    margin: 0 0 0.5rem;
    font-weight: 600;
  }
  .qa-card__question p {
    margin: 0;
    font-size: 1rem;
    color: #1e293b;
    line-height: 1.6;
    font-weight: 500;
  }
  .qa-card__response div {
    font-size: 0.95rem;
    color: #334155;
    line-height: 1.75;
  }
  .qa-card__response div :global(p) { margin: 0.5rem 0; }
  .qa-card__response div :global(.katex-display) {
    margin: 1rem 0;
    overflow-x: auto;
  }
  
  .editable-content[contenteditable="true"] {
    outline: none;
    border-radius: 4px;
    transition: background-color 0.2s, box-shadow 0.2s;
  }
  .editable-content[contenteditable="true"]:hover {
    background-color: rgba(0, 0, 0, 0.02);
  }
  .editable-content[contenteditable="true"]:focus {
    background-color: #fff;
    box-shadow: 0 0 0 2px #c7d2fe;
  }

  /* ── Analysis panel ──────────────────────────────────────────── */
  .analysis-panel {
    margin-top: 1.25rem;
    border-top: 1px dashed #e2e8f0;
    padding-top: 1rem;
  }

  .analysis-trigger {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
    color: white;
    border: none;
    border-radius: 8px;
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.15s, transform 0.15s;
    width: 100%;
    justify-content: center;
  }
  .analysis-trigger:hover { opacity: 0.9; transform: translateY(-1px); }
  .analysis-trigger:active { transform: translateY(0); }

  .analysis-trigger__icon { font-size: 1rem; }
  .analysis-trigger__chevron {
    margin-left: auto;
    font-size: 1.1rem;
    transition: transform 0.2s ease;
    line-height: 1;
  }

  /* Loading */
  .analysis-loading {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    color: #6366f1;
    font-size: 0.9rem;
    font-weight: 500;
  }
  .analysis-spinner {
    width: 18px;
    height: 18px;
    border: 2px solid #e0e7ff;
    border-top-color: #6366f1;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
    flex-shrink: 0;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* Error */
  .analysis-error {
    background: #fef2f2;
    border: 1px solid #fecaca;
    border-radius: 8px;
    padding: 0.75rem 1rem;
    color: #dc2626;
    font-size: 0.85rem;
    margin-top: 0.75rem;
  }

  /* Results grid */
  .analysis-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  @media (max-width: 640px) {
    .analysis-grid { grid-template-columns: 1fr; }
  }

  /* Agent cards */
  .agent-card {
    border-radius: 10px;
    padding: 0.875rem 1rem;
    border: 1px solid transparent;
  }
  .agent-card--question  { background: #eff6ff; border-color: #bfdbfe; }
  .agent-card--response  { background: #f0fdf4; border-color: #bbf7d0; }
  .agent-card--retrieval { background: #fdf4ff; border-color: #e9d5ff; }
  .agent-card--suggestions {
    background: linear-gradient(135deg, #fffbeb 0%, #fef9c3 100%);
    border-color: #fde68a;
    grid-column: 1 / -1;   /* full width — suggestions are the key output */
  }

  .agent-card__badge {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #475569;
    margin-bottom: 0.5rem;
  }
  .agent-card__icon { font-size: 0.95rem; }

  .agent-card__body {
    font-size: 0.85rem;
    color: #334155;
    line-height: 1.6;
  }
  .agent-card__body :global(p)  { margin: 0.25rem 0; }
  .agent-card__body :global(h4) {
    font-size: 0.8rem;
    font-weight: 700;
    color: #1e293b;
    margin: 0.6rem 0 0.2rem;
    text-transform: none;
    letter-spacing: 0;
  }
  .agent-card__body :global(ul) {
    margin: 0.25rem 0;
    padding-left: 1.25rem;
  }
  .agent-card__body :global(li) {
    margin: 0.25rem 0;
    list-style: disc;
  }
  .agent-card__body :global(strong) { font-weight: 700; color: #1e293b; }
  .agent-card__body :global(em)     { font-style: italic; }
  .agent-card__body :global(code) {
    font-family: ui-monospace, monospace;
    font-size: 0.8em;
    background: rgba(0,0,0,0.07);
    border-radius: 3px;
    padding: 0.1em 0.35em;
  }
</style>
